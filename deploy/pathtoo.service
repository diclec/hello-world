[Unit]
Description=PathToo PMO customer workspace (@SERVICE@)
After=network.target

[Service]
Type=simple
User=@SERVICE@
Group=@SERVICE@
WorkingDirectory=/opt/@SERVICE@
EnvironmentFile=/etc/@SERVICE@.env
ExecStart=/opt/pathtoo-node/bin/node /opt/@SERVICE@/server.js
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/@SERVICE@
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
