      "id": "c7a51274-e713-51b1-ad57-281a7758ecc1",
      "name": "Prepare deployment",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "jsCode": "const input=$input.first().json;\nconst fields={customerName:input.customerName,adminName:input.adminName,adminEmail:input.adminEmail};\nconst missing=Object.keys(fields).filter(key=>typeof fields[key]!=='string'||!fields[key].trim());\nif(missing.length)return [{json:{valid:false,response:{status:'needs_input',missing,questions:missing.map(key=>({customerName:'What is the customer name?',adminName:'What is the first administrator\u2019s full name?',adminEmail:'What is the first administrator\u2019s email address?'}[key]))}}}];\nconst requestId=input.requestId||'n8n_'+String($execution.id).padStart(12,'0');\nif(!/^[A-Za-z0-9_-]{8,80}$/.test(requestId))throw Error('Invalid requestId');\nconst request={requestId,customerName:fields.customerName.trim(),adminName:fields.adminName.trim(),adminEmail:fields.adminEmail.trim().toLowerCase()};\nif(request.customerName.length>160||request.adminName.length>160||/[\\x00-\\x1f\\x7f]/.test(request.customerName+request.adminName)||! /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(request.adminEmail)||request.adminEmail.length>254)throw Error('Provide a valid customer name, administrator name and email');\nreturn [{json:{valid:true,requestId,workerId:'pi-ny-db1',payload:JSON.stringify(request)}}];\n"
      }
    },
