      "parameters": {
        "jsCode": "const prepared=$('Prepare deployment').first().json;\nconst row=$input.first().json;\nif(row.id&& (row.payload!==prepared.payload||row.workerId!==prepared.workerId))return [{json:{conflict:true,response:{status:'error',code:'REQUEST_CONFLICT',requestId:prepared.requestId,message:'This requestId already belongs to different customer information. No deployment was changed.'}}}];\nreturn [{json:{...prepared,exists:!!row.id,conflict:false}}];\n"
      }
