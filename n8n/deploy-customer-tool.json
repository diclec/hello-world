    {
      "id": "1225b118-db59-5266-be38-68a10d6bfd30",
      "name": "Check result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2200,
        0
      ],
      "parameters": {
        "jsCode": "const prepared=$('Prepare deployment').first().json,row=$input.first().json;\nif(!row.id)throw Error('Deployment queue row is missing');\nif(row.payload!==prepared.payload||row.workerId!==prepared.workerId)return [{json:{done:true,response:{status:'error',requestId:prepared.requestId,code:'REQUEST_CONFLICT',message:'Queue request identity does not match. No customer link was returned.'}}}];\nif(row.status==='done'){const response=JSON.parse(row.result);if(response.status==='ready'&&response.activationUrl&&Date.parse(response.activationExpiresAt)<=Date.now()){response.activationUrl=null;response.activationExpiresAt=null;response.requiresAdminLinkRecovery=true;}return [{json:{done:true,response}}];}\nif($runIndex>=40)return [{json:{done:true,response:{status:'pending',requestId:prepared.requestId,message:'Deployment is still queued or running. Check the Pi worker. Call this tool again with the same details and requestId to resume waiting; do not create another customer request.'}}}];\nreturn [{json:{done:false}}];\n"
      }
