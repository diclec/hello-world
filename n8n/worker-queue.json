      "name": "Choose job",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        -140
      ],
      "parameters": {
        "jsCode": "const body=$('Worker request').first().json,row=$input.first().json;\nif(!row.id)return [{json:{hasJob:false,response:{ok:true,job:null}}}];\nconst request=JSON.parse(row.payload);\nif(row.workerId!==body.workerId||!['queued','running'].includes(row.status)||request.requestId!==row.requestId)throw Error('Invalid queued deployment');\nreturn [{json:{hasJob:true,rowId:row.id,job:request,requestId:row.requestId}}];\n"
      }
    },
