    {
      "id": "47747143-9212-52fb-9bf5-5e0a4b98bf91",
      "name": "Worker request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "jsCode": "const body=$input.first().json.body;\nif(!body||typeof body!=='object'||!['claim','complete'].includes(body.operation)||!/^[a-z0-9_-]{3,64}$/.test(body.workerId||''))throw Error('Invalid worker request');\nif(body.operation==='complete'){\n if(!Number.isInteger(body.queueRowId)||body.queueRowId<1)throw Error('Invalid queue row ID');\n if(!/^[A-Za-z0-9_-]{8,80}$/.test(body.requestId||'')||!body.result||!['ready','error'].includes(body.result.status)||body.result.requestId!==body.requestId||JSON.stringify(body.result).length>16000)throw Error('Invalid deployment result');\n if(body.result.status==='ready'){\n  const match=body.result.portalUrl?.match(/^https:\\/\\/[a-z0-9-]+\\.[a-z0-9.-]+\\.ts\\.net(?::([0-9]{1,5}))?$/);\n  if(!match||(match[1]&&(Number(match[1])<1024||Number(match[1])>65535)))throw Error('Unexpected portal URL');\n  if(body.result.activationUrl){const prefix=body.result.portalUrl+'/#accept=';if(!body.result.activationUrl.startsWith(prefix)||!/^[a-f0-9]{64}$/.test(body.result.activationUrl.slice(prefix.length)))throw Error('Invalid activation link');}\n  if(body.result.sampleData!==false||body.result.access!=='tailscale-only')throw Error('Deployment did not confirm empty private configuration');\n }\n}\nreturn [{json:body}];\n"
      }
    },
